rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function innskradur() {
      return request.auth != null;
    }

    function erAdmin() {
      return innskradur() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Netföng sem fá sjálfkrafa admin-aðgang (haldist í takt við ADMIN_NETFONG í js/auth.js).
    function erAdminNetfang(email) {
      return email in ['steinim00@gmail.com'];
    }

    // Notendaskjöl: hver notandi má lesa/skrifa sitt eigið, admin má lesa/skrifa allt.
    // Notandi má almennt ekki hækka sjálfan sig í admin - nema netfangið hans sé á
    // ofangreindum lista, sem gerir sjálfheilun í js/auth.js kleifa.
    match /users/{userId} {
      allow read: if innskradur() && (request.auth.uid == userId || erAdmin());
      allow create: if innskradur() && request.auth.uid == userId
                    && (request.resource.data.role == 'user'
                        || (request.resource.data.role == 'admin'
                            && erAdminNetfang(request.resource.data.email)));
      allow update: if erAdmin()
                    || (innskradur() && request.auth.uid == userId
                        && (request.resource.data.role == resource.data.role
                            || (request.resource.data.role == 'admin'
                                && erAdminNetfang(resource.data.email))));
      allow delete: if erAdmin();

      // Tilraunir (svör) notandans. Óbreytanlegar eftir að þær eru skráðar.
      // Skjal-ID = spurningarID, svo hver notandi getur aðeins svarað hverri spurningu einu sinni.
      // "svar" er hráa textasvarið sem notandinn skrifaði (lágstafað/trimmað í js/quiz.js).
      // Réttmæti er ALDREI treyst frá biðlaranum - það er reiknað eftir á með því að
      // bera "svar" saman við answers/{questionId}.correctAnswers.
      match /attempts/{questionId} {
        allow read: if innskradur() && (request.auth.uid == userId || erAdmin());
        allow create: if innskradur() && request.auth.uid == userId
                      && request.resource.data.keys().hasOnly(['svar', 'answeredAt'])
                      && request.resource.data.svar is string
                      && request.resource.data.svar.size() > 0
                      && request.resource.data.svar.size() < 200
                      && exists(/databases/$(database)/documents/questions/$(questionId));
        allow update, delete: if false;
      }

      // Glósur notandans um verkefni - hreinir einkaminnispunktar, ólíkt
      // attempts mega þær breytast/eyðast frjálst. Skjal-ID = verkefniID,
      // ein glósa á hvert verkefni.
      match /glosur/{verkefniId} {
        allow read: if innskradur() && (request.auth.uid == userId || erAdmin());
        allow create, update: if innskradur() && request.auth.uid == userId
                      && request.resource.data.keys().hasOnly(['texti', 'verkefniTitill', 'updatedAt'])
                      && request.resource.data.texti is string
                      && request.resource.data.texti.size() < 5000;
        allow delete: if innskradur() && request.auth.uid == userId;
      }
    }

    // Verkefni: glærur/efni sem nemandi skoðar áður en hann svarar spurningum.
    // { title, slides: [{title, body}], active, createdAt }
    // TÍMABUNDIÐ meðan á þróun/grunnvinnu stendur: lesið opið öllum (líka óinnskráðum)
    // svo hægt sé að skoða verkefni/glærur án innskráningar. Fyrir alvöru notkun:
    // breyttu "if true" aftur í "if innskradur()".
    match /verkefni/{verkefniId} {
      allow read: if true;
      allow write: if erAdmin();
    }

    // Spurningar: lesið opið öllum (sama tímabundna ástæða og hér að ofan),
    // aðeins admin má breyta. Rétt svar er ALDREI geymt hér.
    // "verkefniId" (má vera tómt) tengir spurningu við verkefni.
    match /questions/{questionId} {
      allow read: if true;
      allow write: if erAdmin();
    }

    // Rétt svör ({ correctAnswers: [lágstafað svar, samþykkt afbrigði, ...] }).
    // Admin má alltaf lesa/skrifa. Venjulegur notandi má fyrst lesa svarið EFTIR að
    // hafa sjálfur svarað spurningunni (þ.e. þegar samsvarandi attempts-skjal er
    // þegar til) - kemur í veg fyrir svindl.
    match /answers/{questionId} {
      allow read: if erAdmin() ||
        (innskradur() &&
         exists(/databases/$(database)/documents/users/$(request.auth.uid)/attempts/$(questionId)));
      allow write: if erAdmin();
    }

    // Grænadeildin - handvirk æfingaskráning fyrir liðið (dagsetning, hverjir mættu,
    // rétt/rangt per spurningu fyrir liðið sem heild). Eingöngu admin notar þetta,
    // enginn nemandi les eða skrifar hér.
    match /graenadeildinLidsmenn/{lidsmadurId} {
      allow read, write: if erAdmin();
    }

    match /graenadeildinAefingar/{aefingId} {
      allow read, write: if erAdmin();
    }

    // Sérflokkar (Embættismannalisti, Bókalisti) - uppspretta-gögnin sem
    // stjórnborðið notar til að búa til tvíátta spurningar sjálfkrafa.
    // Eingöngu admin les/skrifar - nemendur sjá eingöngu útkomuna sem
    // venjulegar spurningar í questions/answers.
    match /embaettismenn/{id} {
      allow read, write: if erAdmin();
    }

    match /bokalisti/{id} {
      allow read, write: if erAdmin();
    }
  }
}
